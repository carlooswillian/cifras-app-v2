{
  // Configuração do Cloudflare Workers. Deploy: `npm run deploy` (veja o README).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cifras",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // Banco D1. Sem "database_id", o wrangler cria o banco sozinho no primeiro deploy.
  // As tabelas são criadas automaticamente pelo Worker no primeiro uso.
  "d1_databases": [
    { "binding": "DB", "database_name": "cifras-db" }
  ],
  "observability": { "enabled": true }
}
